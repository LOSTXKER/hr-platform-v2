// HR Platform v2 — Multi-tenant first schema
// Decision: vault/decisions/2026-05-16-hr-platform-v2-master-plan.md
// Pattern: every business table has organization_id + RLS policy

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tenant root — every other table FK to this
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  plan      String   @default("free")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  employees Employee[]

  @@map("organizations")
}

// Maps 1:1 to Supabase auth.users via id (auth_user_id)
model User {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String   @unique
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?

  @@index([organizationId])
  @@map("users")
}

// Employee profile — separate from User (HR data vs auth data)
model Employee {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid
  employeeCode   String   @map("employee_code")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  startDate      DateTime @map("start_date") @db.Date
  status         EmployeeStatus @default(ACTIVE)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@map("employees")
}

enum Role {
  OWNER
  ADMIN
  HR
  MANAGER
  MEMBER
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  RESIGNED
  TERMINATED
}
