// HR Platform v2 — Sprint 1.1 Employee Profile expansion
// Extends Phase 0 schema with full employee profile + lifecycle + org structure
// Sprint scope: vault/projects/hr-platform-v2/features.md §1.1-1.7
// Pattern: every business table has organization_id + RLS policy (see prisma/sql/03_rls_sprint_1_1.sql)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Tenant root
// ============================================================
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  plan      String   @default("free")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users             User[]
  employees         Employee[]
  positions         Position[]
  departments       Department[]
  branches          Branch[]
  shifts            Shift[]
  employeeShifts    EmployeeShift[]
  attendanceRecords AttendanceRecord[]
  leaveTypes        LeaveType[]
  leaveRequests     LeaveRequest[]
  otRequests        OtRequest[]
  pushSubscriptions PushSubscription[]

  @@map("organizations")
}

// ============================================================
// Auth user (1:1 with auth.users via id)
// ============================================================
model User {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String   @unique
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?

  @@index([organizationId])
  @@map("users")
}

// ============================================================
// Position — ตำแหน่งงาน (level + salary band + JD)
// ============================================================
model Position {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  title          String
  level          Int      @default(1)
  salaryBandMin  Decimal? @map("salary_band_min") @db.Decimal(10, 2)
  salaryBandMax  Decimal? @map("salary_band_max") @db.Decimal(10, 2)
  jobDescription String?  @map("job_description")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, title])
  @@index([organizationId])
  @@map("positions")
}

// ============================================================
// Department — แผนก (tree via parent_id)
// ============================================================
model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[] @relation("DepartmentTree")
  employees    Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([parentId])
  @@map("departments")
}

// ============================================================
// Branch — สาขา (multi-location + GPS)
// ============================================================
model Branch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  address        Json?
  gpsLat         Decimal? @map("gps_lat") @db.Decimal(9, 6)
  gpsLng         Decimal? @map("gps_lng") @db.Decimal(9, 6)
  radiusMeters   Int      @default(100) @map("radius_meters")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryEmployees  Employee[]       @relation("EmployeePrimaryBranch")
  employeeBranches  EmployeeBranch[]
  shifts            Shift[]
  attendanceRecords AttendanceRecord[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("branches")
}

// ============================================================
// Employee — extended profile (1.1-1.7)
// Bank account + Tax PIN encrypted via app-level AES-256-GCM (src/lib/crypto.ts)
// ============================================================
model Employee {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  userId         String? @unique @map("user_id") @db.Uuid
  employeeCode   String  @map("employee_code")

  // ส่วนตัว
  firstNameTh   String         @map("first_name_th")
  lastNameTh    String         @map("last_name_th")
  firstNameEn   String?        @map("first_name_en")
  lastNameEn    String?        @map("last_name_en")
  nationalId    String?        @map("national_id") // 13 digits Thai (mod 11 check at app)
  passportNo    String?        @map("passport_no") // foreign workers
  birthDate     DateTime?      @map("birth_date") @db.Date
  gender        Gender?
  nationality   String         @default("THAI")
  religion      String?
  bloodType     BloodType?     @map("blood_type")
  maritalStatus MaritalStatus? @map("marital_status")

  // ติดต่อ
  phonePrimary      String  @map("phone_primary")
  phoneSecondary    String? @map("phone_secondary")
  email             String?
  lineId            String? @map("line_id")
  addressCurrent    Json?   @map("address_current")
  addressRegistered Json?   @map("address_registered")
  sameAddress       Boolean @default(false) @map("same_address")

  // บัญชี (encrypted)
  bankCode             String? @map("bank_code")
  bankAccountNumberEnc String? @map("bank_account_number_enc")
  bankAccountName      String? @map("bank_account_name")

  // ภาษี (PIN encrypted)
  taxPinEnc     String? @map("tax_pin_enc")
  taxDependents Int     @default(0) @map("tax_dependents")
  taxAllowances Json?   @map("tax_allowances") // {insurance, rmf, ssf, ...}

  // Position/org
  positionId      String? @map("position_id") @db.Uuid
  departmentId    String? @map("department_id") @db.Uuid
  primaryBranchId String? @map("primary_branch_id") @db.Uuid
  managerId       String? @map("manager_id") @db.Uuid

  // Status + lifecycle (per features.md §1.7)
  startDate        DateTime       @map("start_date") @db.Date // hire date (= startDate Phase 0)
  probationEndDate DateTime?      @map("probation_end_date") @db.Date // startDate + 119 days (computed at app)
  status           EmployeeStatus @default(APPLICANT)
  statusUpdatedAt  DateTime       @default(now()) @map("status_updated_at")
  resignDate       DateTime?      @map("resign_date") @db.Date
  archiveDate      DateTime?      @map("archive_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  position      Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  primaryBranch Branch?      @relation("EmployeePrimaryBranch", fields: [primaryBranchId], references: [id], onDelete: SetNull)
  manager       Employee?    @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates  Employee[]   @relation("EmployeeManager")

  branches             EmployeeBranch[]
  familyMembers        EmployeeFamilyMember[]
  emergencyContacts    EmployeeEmergencyContact[]
  salaryHistory        SalaryHistory[]
  documents            EmployeeDocument[]
  probationEvaluations ProbationEvaluation[]
  statusHistory        EmployeeStatusHistory[]
  employeeShifts       EmployeeShift[]
  attendanceRecords    AttendanceRecord[]
  leaveRequests        LeaveRequest[]   @relation("LeaveRequester")
  leaveApprovals       LeaveRequest[]   @relation("LeaveApprover")
  otRequests           OtRequest[]      @relation("OtRequester")
  otApprovals          OtRequest[]      @relation("OtApprover")
  pushSubscriptions    PushSubscription[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@index([status])
  @@index([probationEndDate])
  @@map("employees")
}

// ============================================================
// EmployeeBranch — junction (1 พนักงาน N สาขา, 1 หลัก mirror in Employee.primaryBranchId)
// ============================================================
model EmployeeBranch {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, branchId])
  @@index([employeeId])
  @@index([branchId])
  @@map("employee_branches")
}

// ============================================================
// EmployeeFamilyMember — ครอบครัว (ลดหย่อนภาษี + emergency reference)
// ============================================================
model EmployeeFamilyMember {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String         @map("employee_id") @db.Uuid
  relation   FamilyRelation
  fullName   String         @map("full_name")
  nationalId String?        @map("national_id") // only for spouse/children (tax deduction)
  birthDate  DateTime?      @map("birth_date") @db.Date
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_family_members")
}

// ============================================================
// EmployeeEmergencyContact — ผู้ติดต่อฉุกเฉิน 1-2 คน
// ============================================================
model EmployeeEmergencyContact {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  fullName   String   @map("full_name")
  relation   String // free text "พี่สาว", "เพื่อน"
  phone      String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

// ============================================================
// SalaryHistory — ประวัติเงินเดือน (append-only)
// ============================================================
model SalaryHistory {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  effectiveDate DateTime  @map("effective_date") @db.Date
  oldSalary     Decimal   @map("old_salary") @db.Decimal(10, 2)
  newSalary     Decimal   @map("new_salary") @db.Decimal(10, 2)
  reason        String // "annual", "promotion", "restructure", "other"
  reasonNotes   String?   @map("reason_notes")
  approverId    String?   @map("approver_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at")
  documentUrl   String?   @map("document_url")
  createdAt     DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([effectiveDate])
  @@map("salary_history")
}

// ============================================================
// EmployeeDocument — คลังไฟล์ (Supabase Storage path ref)
// ============================================================
model EmployeeDocument {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String       @map("employee_id") @db.Uuid
  type        DocumentType
  fileName    String       @map("file_name")
  storagePath String       @map("storage_path") // Supabase Storage path
  fileSize    Int          @map("file_size")
  mimeType    String       @map("mime_type")
  expiresAt   DateTime?    @map("expires_at") @db.Date
  uploadedBy  String?      @map("uploaded_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([type])
  @@index([expiresAt])
  @@map("employee_documents")
}

// ============================================================
// ProbationEvaluation — ประเมินทดลองงาน 119 วัน
// ============================================================
model ProbationEvaluation {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String            @map("employee_id") @db.Uuid
  evaluatorId String?           @map("evaluator_id") @db.Uuid
  evaluatedAt DateTime          @map("evaluated_at")
  decision    ProbationDecision
  score       Int? // 1-5 or 1-10 (app-defined)
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([evaluatedAt])
  @@map("probation_evaluations")
}

// ============================================================
// EmployeeStatusHistory — state machine log (per features.md §1.7)
// ============================================================
model EmployeeStatusHistory {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String          @map("employee_id") @db.Uuid
  fromStatus EmployeeStatus? @map("from_status")
  toStatus   EmployeeStatus  @map("to_status")
  reason     String?
  actorId    String?         @map("actor_id") @db.Uuid
  changedAt  DateTime        @default(now()) @map("changed_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([changedAt])
  @@map("employee_status_history")
}

// ============================================================
// Enums
// ============================================================

enum Role {
  OWNER
  ADMIN
  HR
  MANAGER
  MEMBER
}

enum EmployeeStatus {
  APPLICANT
  PROBATION
  PERMANENT
  RESIGNED
  TERMINATED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodType {
  A
  B
  AB
  O
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum FamilyRelation {
  SPOUSE
  FATHER
  MOTHER
  CHILD
}

enum DocumentType {
  NATIONAL_ID
  HOUSE_REGISTRATION
  EDUCATION_CERT
  TRANSCRIPT
  PREVIOUS_EMPLOYMENT
  MEDICAL_CERT
  EMPLOYMENT_CONTRACT
  WARNING_LETTER
  OTHER
}

enum ProbationDecision {
  PASS
  FAIL
  EXTEND
}

// ============================================================
// Sprint 1.2 — Attendance (features.md §2.1, §2.4, §2.6, §2.7, §2.8)
// ============================================================

// Shift — กะการทำงาน template (08:00-17:00, 14:00-22:00, ...)
// startTime/endTime stored as minutes since midnight (0..1439) for shift-spans-midnight support
model Shift {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid // optional — shift can be org-wide or branch-specific
  name           String // "กะเช้า", "กะบ่าย", "กะดึก"
  startMinutes   Int      @map("start_minutes") // 0..1439 (e.g. 8*60 = 480 for 08:00)
  endMinutes     Int      @map("end_minutes") // can be < startMinutes if crosses midnight (e.g. 22*60 → 6*60)
  breakMinutes   Int      @default(0) @map("break_minutes") // total break time (lunch + snacks) — deduct from worked hours
  graceMinutes   Int      @default(5) @map("grace_minutes") // late grace period
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employeeShifts EmployeeShift[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([branchId])
  @@map("shifts")
}

// EmployeeShift — assign กะให้พนักงานเป็นรายวัน (1 คน 1 shift ต่อวัน)
model EmployeeShift {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  shiftId        String   @map("shift_id") @db.Uuid
  workDate       DateTime @map("work_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift        Shift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([employeeId, workDate]) // 1 คน 1 กะ ต่อวัน
  @@index([organizationId])
  @@index([workDate])
  @@map("employee_shifts")
}

// AttendanceRecord — check-in/out events + GPS + selfie + computed status
// 1 record = 1 event (not 1 day) — pair check-in with check-out for full shift
model AttendanceRecord {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  branchId       String?          @map("branch_id") @db.Uuid // branch ที่เช็คอิน (null ถ้านอกสถานที่ approved)
  type           AttendanceType
  method         AttendanceMethod
  status         AttendanceStatus @default(ON_TIME)
  occurredAt     DateTime         @map("occurred_at") // when event happened
  gpsLat         Decimal?         @map("gps_lat") @db.Decimal(9, 6)
  gpsLng         Decimal?         @map("gps_lng") @db.Decimal(9, 6)
  gpsAccuracyM   Int?             @map("gps_accuracy_m") // meters reported by browser
  insideGeofence Boolean?         @map("inside_geofence") // null if no branch/GPS check
  selfieUrl      String?          @map("selfie_url") // Supabase Storage path
  offlineSyncId  String?          @map("offline_sync_id") // dedupe key for PWA sync
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([offlineSyncId]) // null allowed, prevents duplicate sync from PWA
  @@index([organizationId])
  @@index([employeeId])
  @@index([occurredAt])
  @@index([employeeId, occurredAt])
  @@map("attendance_records")
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
  BREAK_START
  BREAK_END
}

enum AttendanceMethod {
  GPS // mobile PWA with GPS + selfie
  QR // QR kiosk at factory
  MANUAL // HR override (no GPS / forgot check-out)
  FINGERPRINT // Phase 3 — biometric device
}

enum AttendanceStatus {
  ON_TIME
  LATE
  EARLY // ออกก่อน shift end
  MISSING // ลืม check-out → auto-generated by cron
  OUT_OF_GEOFENCE
}

// ============================================================
// Sprint 1.3 — Leave Management (features.md §3.1-3.3, §3.6)
// ============================================================

// LeaveType — ประเภทลา (config per org)
// codes: SICK, ANNUAL, PERSONAL, MATERNITY, ORDINATION, BEREAVEMENT, WFH, MILITARY, TRAINING (Thai law)
model LeaveType {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  code                String // SICK, ANNUAL, ... (unique per org for lookup)
  nameTh              String   @map("name_th")
  defaultQuotaDays    Int      @map("default_quota_days") // 0 = unlimited (WFH, MILITARY)
  deductsQuota        Boolean  @default(true) @map("deducts_quota") // false = doesn't reduce balance (training)
  requiresAttachment  Boolean  @default(false) @map("requires_attachment") // medical cert, etc.
  attachmentThresholdDays Int? @map("attachment_threshold_days") // attach required only if days > this (e.g. sick > 3)
  carryoverMaxDays    Int      @default(0) @map("carryover_max_days") // max days that roll over to next year
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests     LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("leave_types")
}

// LeaveRequest — single source of truth for leave requests + approval
model LeaveRequest {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  employeeId      String       @map("employee_id") @db.Uuid
  leaveTypeId     String       @map("leave_type_id") @db.Uuid
  startDate       DateTime     @map("start_date") @db.Date
  endDate         DateTime     @map("end_date") @db.Date
  days            Decimal      @db.Decimal(5, 2) // supports half-day (0.5)
  reason          String
  attachmentUrl   String?      @map("attachment_url") // Supabase Storage path (medical cert)
  status          LeaveStatus  @default(PENDING)
  approverId      String?      @map("approver_id") @db.Uuid
  decidedAt       DateTime?    @map("decided_at")
  decisionNotes   String?      @map("decision_notes")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  approver     Employee?    @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([employeeId, status])
  @@map("leave_requests")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ============================================================
// Sprint 1.4 — OT Requests (features.md §4.1, §4.2 simplified, §4.4)
// ============================================================

// OtRequest — pre-request OT before working
// Day-type stored simple: WEEKDAY/WEEKEND/HOLIDAY. Multiplier per Thai law:
//   WEEKDAY:  1.5x of hourly rate
//   WEEKEND:  3x of hourly rate (Thai law: 1x regular + 3x OT, but most companies pay 3x flat)
//   HOLIDAY:  3x of hourly rate
// Phase 1: hourly rate manual input. Phase 2 payroll: auto-derive from salary.
model OtRequest {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  employeeId      String      @map("employee_id") @db.Uuid
  workDate        DateTime    @map("work_date") @db.Date
  startMinutes    Int         @map("start_minutes") // minutes from midnight (local Bkk)
  endMinutes      Int         @map("end_minutes")
  hours           Decimal     @db.Decimal(5, 2) // computed at create (handles midnight cross)
  dayType         OtDayType   @default(WEEKDAY) @map("day_type")
  hourlyRate      Decimal?    @map("hourly_rate") @db.Decimal(10, 2) // baht/hour at time of request
  estimatedPay    Decimal?    @map("estimated_pay") @db.Decimal(10, 2)
  reason          String
  status          OtStatus    @default(REQUESTED)
  approverId      String?     @map("approver_id") @db.Uuid
  decidedAt       DateTime?   @map("decided_at")
  decisionNotes   String?     @map("decision_notes")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("OtRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  approver     Employee?    @relation("OtApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
  @@index([workDate])
  @@index([employeeId, workDate])
  @@map("ot_requests")
}

enum OtStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum OtDayType {
  WEEKDAY
  WEEKEND
  HOLIDAY
}

// ============================================================
// Sprint 1.5 — Web Push subscriptions
// ============================================================
model PushSubscription {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  endpoint       String   @unique // browser-specific URL
  p256dh         String // base64 public key
  authSecret     String   @map("auth_secret") // base64 auth secret
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")
  lastUsedAt     DateTime @default(now()) @map("last_used_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([employeeId])
  @@map("push_subscriptions")
}
