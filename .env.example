# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Database — Prisma direct connection (Settings → Database → Connection string)
# Note: use Session pooler for Vercel (port 5432), Direct connection for migrations (port 5432 non-pooler)
DATABASE_URL=postgresql://postgres.[project]:[pwd]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[project]:[pwd]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Encryption — generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=<32-byte-base64>
